# 클라우드(여러 VM) 실행 설정. 여기만 고치면 된다. 모든 스크립트가 이 파일을 읽는다.
# 주소는 VPC 안의 사설 IP 를 쓴다(같은 지역·같은 가용 영역). 공인 IP 는 SSH_HOST_* 에만 쓴다.

# ── VM 사설 IP (VM 끼리 통신) ─────────────────────────────────────────
FABRIC_IP=10.0.1.x      # ② 오더러, 피어 2, 체인코드 (실험 구동도 여기서 한다)
KAFKA_IP=10.0.1.x       # ③ Kafka 브로커 3, ZooKeeper 3, 프로세서, MongoDB
CLIENT_IP=10.0.1.x     # ① Caliper
WATCHDOG_IP=10.0.1.x     # ④ Kubernetes(k3s) s-node 3, w-node 10

# ── 내 PC 에서 각 VM 으로 SSH 할 때 (공인 IP 또는 DNS) ────────────────
SSH_USER=ubuntu
SSH_KEY=~/.ssh/serializer-aws.pem
SSH_HOST_FABRIC=<public-ip-or-dns>
SSH_HOST_KAFKA=<public-ip-or-dns>
SSH_HOST_CLIENT=<public-ip-or-dns>
SSH_HOST_WATCHDOG=<public-ip-or-dns>

# ── VM 안의 작업 폴더. 로컬과 같은 상대 구조를 둔다 ───────────────────
#   $WORK/Serializer/{kafka,watchdog,deploy}   $WORK/HLF/fabric-samples/zipfbench
WORK=/opt/work

# ── 이미지 (로컬 PC 의 것을 그대로 옮긴다. 00-export-images.sh) ─────────
ORDERER_IMAGE=serializer/fabric-orderer:meta          # B(Serializer·Fabric++·HTFabric): Kafka 내부 경로 + 메타데이터 전송
PEER_IMAGE=serializer/fabric-peer:latest
TOOLS_IMAGE=serializer/fabric-tools:latest
VANILLA_ORDERER_IMAGE=zipfbench/fabric-orderer-vanilla:latest   # A1 (같은 소스 Fabric)
CC_IMAGE=zipfbench/chaincode-smallbank:latest
PROCESSOR_IMAGE=weave-kafka/processor:meta
CALIPER_IMAGE=serializer/caliper:latest
SNODE_IMAGE=watchdog/s-node:mttr-1017g
WNODE_IMAGE=watchdog/w-node:mttr-1017f

# ── 실험 기본값 (userbench.sh 에 그대로 넘어간다. 실행할 때 덮어써도 된다) ──
WORKERS=${WORKERS:-5}
CALIPER_TIMEOUT=${CALIPER_TIMEOUT:-30}
WNODE_COUNT=10
